<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- DROP / SELECT ZONE -->
        <Border Grid.Row="0" Margin="0,0,0,8" Padding="16,12,16,12"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Button x:Name="btnSelectLogs"
                        DockPanel.Dock="Right"
                        Content="Select Logs..."
                        Width="120" Height="32"
                        Style="{DynamicResource MahApps.Styles.Button.Square}"
                        Controls:ControlsHelper.ContentCharacterCasing="Normal"/>
                <TextBlock x:Name="txtDropHint"
                           VerticalAlignment="Center"
                           Text="Drop a log bundle here, or click Select Logs to browse."
                           Foreground="{DynamicResource MahApps.Brushes.Gray1}"/>
            </DockPanel>
        </Border>

        <!-- VERDICT CARD (top) -->
        <Border x:Name="verdictCard" Grid.Row="1" Margin="0,0,0,8" Padding="20,16,20,16"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Rule id + scope -->
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock x:Name="txtVerdictRuleId"
                               DockPanel.Dock="Left"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="11"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                               Text="no-incident-loaded"/>
                    <TextBlock x:Name="txtVerdictScope"
                               DockPanel.Dock="Right"
                               FontSize="11"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                               Text=""/>
                </DockPanel>

                <!-- Verdict sentence (headline) -->
                <TextBlock Grid.Row="1"
                           x:Name="txtVerdictHeadline"
                           Text="No verdict yet. Drop a log bundle to analyze."
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,4,0,10"/>

                <!-- Confidence meter: brand-neutral ThemeForeground bar. -->
                <DockPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" Text="Confidence " FontSize="11"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtConfidenceValue"
                               DockPanel.Dock="Right"
                               Text="--"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               FontFamily="Cascadia Code, Consolas, Courier New"/>
                    <ProgressBar x:Name="barConfidence"
                                 Height="6"
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                 Background="{DynamicResource MahApps.Brushes.Gray8}"
                                 Margin="8,0,0,0"/>
                </DockPanel>

                <!-- Evidence label -->
                <TextBlock Grid.Row="3" Text="Evidence"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                           Margin="0,4,0,4"/>

                <!-- Evidence items (bound later; 3 placeholders now). -->
                <ItemsControl x:Name="lstEvidence" Grid.Row="4" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Component}"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="11"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Message}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Fix + action buttons -->
                <DockPanel Grid.Row="5" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="btnCaptureAsRule"
                                Content="Capture as Rule..."
                                Width="150" Height="28"
                                Margin="8,0,0,0"
                                Style="{DynamicResource MahApps.Styles.Button.Square}"
                                Controls:ControlsHelper.ContentCharacterCasing="Normal"
                                IsEnabled="False"
                                ToolTip="Author a new rule from the current triage"/>
                        <Button x:Name="btnCopyFix"
                                Content="Copy Fix"
                                Width="100" Height="28"
                                Margin="8,0,0,0"
                                Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                                Controls:ControlsHelper.ContentCharacterCasing="Normal"
                                IsEnabled="False"
                                ToolTip="Copy the recommended fix to clipboard"/>
                    </StackPanel>

                    <TextBlock x:Name="txtFix"
                               Text=""
                               TextWrapping="Wrap"
                               MaxHeight="120"
                               Margin="0,0,12,0"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ALTERNATE VERDICTS + SHOW RAW ANALYSIS -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Alternate Verdicts"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                       Margin="0,4,0,4"/>

            <ItemsControl x:Name="lstAlternateVerdicts" Grid.Row="1" Margin="0,0,0,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2,0,2" Padding="10,6,10,6"
                                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding RuleId}"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray1}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Verdict}"
                                           Margin="10,0,10,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Confidence}"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray1}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Expander Grid.Row="2" Header="Show raw analysis" IsExpanded="False" FontSize="11">
                <Border Padding="8,8,8,8"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="1">
                    <TextBlock Text="Raw analysis grid will appear here once wired up (Session 11)."
                               FontSize="11"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"/>
                </Border>
            </Expander>
        </Grid>
    </Grid>
</UserControl>
