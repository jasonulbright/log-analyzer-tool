<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,4,4,4">

            <TextBlock Text="Rulebase paths, incident retention, and logging preferences."
                       FontSize="12"
                       Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <!-- Rulebase section -->
            <TextBlock Text="Rulebase" FontSize="13" FontWeight="Bold"
                       Margin="0,0,0,8"/>
            <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                    BorderThickness="1" Padding="12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Baseline path" VerticalAlignment="Center" FontSize="12" Margin="0,4,0,4" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtBaselinePath" IsReadOnly="True" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="11" Margin="0,2,8,2" BorderThickness="0" Background="Transparent"/>
                    <Button    Grid.Row="0" Grid.Column="2" x:Name="btnOpenBaseline" Content="Open"
                               MinWidth="70" Height="26" Margin="0,2,0,2"
                               Style="{DynamicResource MahApps.Styles.Button.Square}"
                               Controls:ControlsHelper.ContentCharacterCasing="Normal"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Local overlay" VerticalAlignment="Center" FontSize="12" Margin="0,4,0,4" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtOverlayPath" IsReadOnly="True" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="11" Margin="0,2,8,2" BorderThickness="0" Background="Transparent"/>
                    <Button    Grid.Row="1" Grid.Column="2" x:Name="btnOpenOverlay" Content="Open"
                               MinWidth="70" Height="26" Margin="0,2,0,2"
                               Style="{DynamicResource MahApps.Styles.Button.Square}"
                               Controls:ControlsHelper.ContentCharacterCasing="Normal"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Rules loaded" VerticalAlignment="Center" FontSize="12" Margin="0,4,0,4" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtRuleCount" FontSize="12" Margin="0,4,0,4" Text="(scanning)"/>
                    <Button    Grid.Row="2" Grid.Column="2" x:Name="btnReloadRules" Content="Reload"
                               MinWidth="70" Height="26" Margin="0,2,0,2"
                               Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                               Controls:ControlsHelper.ContentCharacterCasing="Normal"/>
                </Grid>
            </Border>

            <!-- Incident storage section -->
            <TextBlock Text="Incident storage" FontSize="13" FontWeight="Bold"
                       Margin="0,0,0,8"/>
            <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                    BorderThickness="1" Padding="12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Incident root" VerticalAlignment="Center" FontSize="12" Margin="0,4,0,4" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtIncidentRoot" IsReadOnly="True" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="11" Margin="0,2,8,2" BorderThickness="0" Background="Transparent"/>
                    <Button    Grid.Row="0" Grid.Column="2" x:Name="btnOpenIncidents" Content="Open"
                               MinWidth="70" Height="26" Margin="0,2,0,2"
                               Style="{DynamicResource MahApps.Styles.Button.Square}"
                               Controls:ControlsHelper.ContentCharacterCasing="Normal"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Retention cap" VerticalAlignment="Center" FontSize="12" Margin="0,4,0,4" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtRetentionCap" FontSize="12" Margin="0,4,0,4" Text="50 (default, FIFO)"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Incidents stored" VerticalAlignment="Center" FontSize="12" Margin="0,4,0,4" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtIncidentCount" FontSize="12" Margin="0,4,0,4" Text="(scanning)"/>
                    <Button    Grid.Row="2" Grid.Column="2" x:Name="btnTrimIncidents" Content="Trim now"
                               MinWidth="90" Height="26" Margin="0,2,0,2"
                               Style="{DynamicResource MahApps.Styles.Button.Square}"
                               Controls:ControlsHelper.ContentCharacterCasing="Normal"/>
                </Grid>
            </Border>

            <!-- About section -->
            <TextBlock Text="About" FontSize="13" FontWeight="Bold"
                       Margin="0,0,0,8"/>
            <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                    BorderThickness="1" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource MahApps.Brushes.Gray3}" TextWrapping="Wrap">
                        Log Analyzer Tool -- decision engine pivot.  Baseline rules ship with the build;
                        local-overlay rules are authored via Triage -> Capture as rule.  History module
                        replays stored incidents against the current rulebase so newly-authored rules
                        can be validated against prior triage runs.
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
