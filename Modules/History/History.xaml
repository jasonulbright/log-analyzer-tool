<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Intro -->
            <RowDefinition Height="Auto"/>  <!-- Action row -->
            <RowDefinition Height="*"/>     <!-- DataGrid -->
            <RowDefinition Height="Auto"/>  <!-- Diff pane label -->
            <RowDefinition Height="160"/>   <!-- Diff pane -->
            <RowDefinition Height="Auto"/>  <!-- Footer count -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Stored incidents from prior triage runs. Re-analyze replays a bundle against the current rulebase so you can see how a new rule would have scored."
                   FontSize="12"
                   Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                   TextWrapping="Wrap"
                   Margin="4,4,4,10"/>

        <!-- Action row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,4,8">
            <Button x:Name="btnHistRefresh"   Content="Refresh"        MinWidth="100" Height="30" Margin="0,0,8,0"
                    Style="{DynamicResource MahApps.Styles.Button.Square}"
                    Controls:ControlsHelper.ContentCharacterCasing="Normal"/>
            <Button x:Name="btnHistReanalyze" Content="Re-analyze"     MinWidth="110" Height="30" Margin="0,0,8,0" IsEnabled="False"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                    Controls:ControlsHelper.ContentCharacterCasing="Normal"/>
            <Button x:Name="btnHistOpenFolder" Content="Open folder"   MinWidth="110" Height="30" Margin="0,0,8,0"
                    Style="{DynamicResource MahApps.Styles.Button.Square}"
                    Controls:ControlsHelper.ContentCharacterCasing="Normal"/>
        </StackPanel>

        <DataGrid x:Name="gridHistory"
                  Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="None" CanUserReorderColumns="False"
                  CanUserResizeRows="False" BorderThickness="1"
                  BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                  Margin="4,0,4,8"
                  RowHeight="26" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp (local)" Binding="{Binding TimestampLocal}" Width="170"/>
                <DataGridTextColumn Header="Label"             Binding="{Binding Label}"          Width="180"/>
                <DataGridTextColumn Header="Entries"           Binding="{Binding EntryCount}"     Width="80"/>
                <DataGridTextColumn Header="Matches"           Binding="{Binding MatchedRuleCount}" Width="80"/>
                <DataGridTextColumn Header="Top verdict"       Binding="{Binding TopVerdictRuleId}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3"
                   Text="Replay diff"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                   Margin="4,0,4,2"/>

        <Border Grid.Row="4"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1" Padding="8" Margin="4,0,4,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="txtHistDiff"
                         IsReadOnly="True" AcceptsReturn="True"
                         BorderThickness="0" Background="Transparent"
                         FontFamily="Cascadia Code, Consolas, Courier New" FontSize="11"
                         Text="Select an incident and click Re-analyze to see how it would be scored by the current rulebase."/>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="txtHistFooter"
                   Grid.Row="5"
                   FontSize="11"
                   Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                   Margin="4,0,4,4"
                   Text="Loading history..."/>
    </Grid>
</UserControl>
